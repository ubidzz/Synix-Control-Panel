<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RootNamespace>Synix_Control_Panel</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>Images\Synix_logo_Icon.ico</ApplicationIcon>
		<AssemblyName>Synix Control Panel</AssemblyName>
		<AssemblyTitle>Synix</AssemblyTitle>
		<PackageProjectUrl>https://github.com/ubidzz/Synix-Control-Panel/blob/master/README.md</PackageProjectUrl>
		<Copyright>Copyright © 2026 Jason Turner (ubidzz). All Rights Reserved.</Copyright>
		<Description>PC Game Server Hosting</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/ubidzz/Synix-Control-Panel</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Version>1.0.21</Version>
		<AssemblyVersion>$(Version).0</AssemblyVersion>
		<FileVersion>$(Version).0</FileVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
		<SynixBuildChannel Condition="'$(SynixBuildChannel)' == '' and ('$(_IsPublishing)' == 'true' or '$(PublishProfile)' != '' or '$(WebPublishProfileFile)' != '')">Stable</SynixBuildChannel>
		<SynixBuildChannel Condition="'$(SynixBuildChannel)' == ''">Development</SynixBuildChannel>
		<DefineConstants Condition="'$(SynixBuildChannel)' == 'Stable'">$(DefineConstants);SYNIX_STABLE_RELEASE</DefineConstants>
		<NeutralLanguage>en-US</NeutralLanguage>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<PackageIcon>SyniX logo with glowing accents.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="SynixApp\**" />
	  <Compile Remove="Tests\**" />
	  <EmbeddedResource Remove="SynixApp\**" />
	  <EmbeddedResource Remove="Tests\**" />
	  <None Remove="SynixApp\**" />
	  <None Remove="Tests\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="SynixEngine\version.txt" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="Images\SyniX logo.ico" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="SynixEngine\version.txt" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyMetadata Include="SynixBuildChannel" Value="$(SynixBuildChannel)" />
		<PackageReference Include="System.Management" Version="10.0.7" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="UI\GeneralSettingsPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\GeneralSettingsPage.Designer.cs">
	    <DependentUpon>GeneralSettingsPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\BackupSettingsPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\BackupSettingsPage.Designer.cs">
	    <DependentUpon>BackupSettingsPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\PrivacySettingsPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\PrivacySettingsPage.Designer.cs">
	    <DependentUpon>PrivacySettingsPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\AdvancedSettingsPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\AdvancedSettingsPage.Designer.cs">
	    <DependentUpon>AdvancedSettingsPage.cs</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="Images\SyniX logo with glowing accents.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Update="Properties\Settings.settings">
		  <Generator>SettingsSingleFileGenerator</Generator>
		  <LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<Target Name="RunInnoAfterPublish" AfterTargets="Publish">
		<PropertyGroup>
			<_SynixPublishedExe>$([System.IO.Path]::Combine('$(PublishDir)', '$(AssemblyName).exe'))</_SynixPublishedExe>
			<_SynixSetupExe>$([System.IO.Path]::Combine('$(PublishDir)', 'package', 'Output', 'SynixSetup.exe'))</_SynixSetupExe>
			<_SynixInnoScript>$([System.IO.Path]::Combine('$(PublishDir)', 'package', 'Synix.iss'))</_SynixInnoScript>
			<_SynixTestsProject>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Tests', 'Synix.Tests.csproj'))</_SynixTestsProject>
			<_SynixDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_SynixDotNetHost>
			<_SynixDotNetHost Condition="'$(_SynixDotNetHost)' == ''">$([System.IO.Path]::Combine('$(ProgramFiles)', 'dotnet', 'dotnet.exe'))</_SynixDotNetHost>
		</PropertyGroup>
		<Error Condition="'$(SynixBuildChannel)' != 'Stable'" Text="Synix Publish was not marked as a Stable release build." />
		<Error Condition="!Exists('$(_SynixPublishedExe)')" Text="The published Synix executable was not found at $(_SynixPublishedExe)." />
		<Error Condition="!Exists('$(_SynixInnoScript)')" Text="The Inno Setup script was not found at $(_SynixInnoScript)." />
		<Error Condition="!Exists('$(_SynixTestsProject)')" Text="The Synix automated test project was not found at $(_SynixTestsProject)." />
		<Error Condition="!Exists('$(_SynixDotNetHost)')" Text="The 64-bit .NET host was not found at $(_SynixDotNetHost). Repair the Visual Studio .NET SDK before publishing." />
		<Message Text="Running the complete Synix automated test suite before packaging..." Importance="high" />
		<Exec
			Command="&quot;$(_SynixDotNetHost)&quot; test &quot;$(_SynixTestsProject)&quot; --configuration Release --logger &quot;console;verbosity=minimal&quot;"
			WorkingDirectory="$(MSBuildProjectDirectory)" />
		<PropertyGroup>
			<_SynixAutomatedTestsUtc>$([System.DateTime]::UtcNow.ToString('O'))</_SynixAutomatedTestsUtc>
		</PropertyGroup>
		<Exec Command="powershell -Command &quot;Start-Sleep -s 5&quot;" />
		<Message Text="Windows metadata synced. Starting Inno Setup..." Importance="high" />
		<Message Text="Sending Version $(Version) to Inno Setup..." Importance="high" />
		<Exec Command="&quot;C:\Program Files (x86)\Inno Setup 6\ISCC.exe&quot; /DAppProtoVersion=$(Version) /DSourcePath=&quot;$(PublishDir)&quot; &quot;$(_SynixInnoScript)&quot;" />
		<Error Condition="!Exists('$(_SynixSetupExe)')" Text="Inno Setup did not create $(_SynixSetupExe)." />
	</Target>

	<Target Name="WriteSynixReleaseManifest" AfterTargets="RunInnoAfterPublish">
		<PropertyGroup>
			<_SynixPublishedExe>$([System.IO.Path]::Combine('$(PublishDir)', '$(AssemblyName).exe'))</_SynixPublishedExe>
			<_SynixSetupExe>$([System.IO.Path]::Combine('$(PublishDir)', 'package', 'Output', 'SynixSetup.exe'))</_SynixSetupExe>
			<_SynixReleaseManifest>$([System.IO.Path]::Combine('$(PublishDir)', 'Synix.release-manifest.txt'))</_SynixReleaseManifest>
			<_SynixReleaseManifestBackup>$([System.IO.Path]::Combine('$(PublishDir)', 'package', 'Output', 'Synix.release-manifest.txt'))</_SynixReleaseManifestBackup>
		</PropertyGroup>
		<Error Condition="'$(_SynixAutomatedTestsUtc)' == ''" Text="The automated tests did not produce a passing release receipt." />
		<Error Condition="!Exists('$(_SynixPublishedExe)')" Text="The published Synix executable was not found at $(_SynixPublishedExe)." />
		<Error Condition="!Exists('$(_SynixSetupExe)')" Text="The Synix installer was not found at $(_SynixSetupExe)." />
		<ItemGroup>
			<_SynixStandaloneFile Include="$(_SynixPublishedExe)" />
			<_SynixSetupFile Include="$(_SynixSetupExe)" />
		</ItemGroup>
		<GetFileHash Files="@(_SynixStandaloneFile)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="_SynixStandaloneHashed" />
		</GetFileHash>
		<GetFileHash Files="@(_SynixSetupFile)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="_SynixSetupHashed" />
		</GetFileHash>
		<PropertyGroup>
			<_SynixStandaloneSha256>@(_SynixStandaloneHashed-&gt;'%(FileHash)')</_SynixStandaloneSha256>
			<_SynixSetupSha256>@(_SynixSetupHashed-&gt;'%(FileHash)')</_SynixSetupSha256>
		</PropertyGroup>
		<Error Condition="'$(_SynixStandaloneSha256)' == ''" Text="The standalone SHA-256 hash could not be created." />
		<Error Condition="'$(_SynixSetupSha256)' == ''" Text="The installer SHA-256 hash could not be created." />
		<ItemGroup>
			<_SynixReleaseManifestLine Include="FormatVersion=1" />
			<_SynixReleaseManifestLine Include="Version=$(Version)" />
			<_SynixReleaseManifestLine Include="Channel=$(SynixBuildChannel)" />
			<_SynixReleaseManifestLine Include="AutomatedTests=Passed" />
			<_SynixReleaseManifestLine Include="AutomatedTestsUtc=$(_SynixAutomatedTestsUtc)" />
			<_SynixReleaseManifestLine Include="StandaloneFile=$(AssemblyName).exe" />
			<_SynixReleaseManifestLine Include="StandaloneSha256=$(_SynixStandaloneSha256)" />
			<_SynixReleaseManifestLine Include="SetupFile=package\Output\SynixSetup.exe" />
			<_SynixReleaseManifestLine Include="SetupSha256=$(_SynixSetupSha256)" />
		</ItemGroup>
		<WriteLinesToFile
			File="$(_SynixReleaseManifest)"
			Lines="@(_SynixReleaseManifestLine)"
			Overwrite="true"
			Encoding="UTF-8" />
		<Copy SourceFiles="$(_SynixReleaseManifest)" DestinationFiles="$(_SynixReleaseManifestBackup)" />
		<Error Condition="!Exists('$(_SynixReleaseManifest)')" Text="The Synix release manifest was not created at $(_SynixReleaseManifest)." />
		<Error Condition="!Exists('$(_SynixReleaseManifestBackup)')" Text="The backup release manifest was not created at $(_SynixReleaseManifestBackup)." />
		<Message Text="Synix release manifest created at $(_SynixReleaseManifest)." Importance="high" />
	</Target>
</Project>
